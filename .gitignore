.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# IDE
.idea/
# (report/.vscode/settings.json is kept: it holds the LaTeX build recipe)
.vscode/*
!.vscode/settings.json
!report/.vscode/

# ---- simulations/ ----
# Simulation/output files
simulations/**/*.h5
simulations/**/*.log
simulations/**/*.tmp

# Pinned production meshes, regenerated from results/ by `python -m snspd.sim pin-meshes`
simulations/meshes/

# Event arrays (traces, snapshots, mesh): large and regenerated by event.py; the .json and .png are kept
simulations/results/events/*.npz
simulations/results/variants/*.npz

# ---- report/ ----
# LaTeX build products are ignored in report/.gitignore

# Windows download markers
*Zone.Identifier
